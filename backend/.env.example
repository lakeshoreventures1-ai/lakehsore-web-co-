# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Public base URL this server is reachable at (used to configure Twilio webhooks
# on each number this service buys). Set after you deploy, e.g. to Render/Fly.io.
PUBLIC_BASE_URL=https://your-deployed-app.example.com

# Port the server listens on
PORT=3000
