# ---- Required for the core product ----
ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Public URL this server is reachable at (Twilio webhooks + demo links are built from it)
PUBLIC_BASE_URL=https://your-deployed-app.example.com
# Shared secret for admin endpoints: send "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Self-serve billing (Stripe) ----
STRIPE_SECRET_KEY=sk_live_...
# Price of the $249/month recurring product you create in the Stripe dashboard
STRIPE_PRICE_ID=price_...
# From Stripe -> Developers -> Webhooks, endpoint <PUBLIC_BASE_URL>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
TRIAL_DAYS=30
# The static marketing site (allowed to call /api/checkout; success page lives here)
SITE_URL=https://cnddigital.org

# ---- Email (Resend) - welcome emails, weekly reports, outreach, alerts ----
RESEND_API_KEY=re_...
EMAIL_FROM=Charlie at CND Digital <charlie@cnddigital.org>
EMAIL_REPLY_TO=charlie@cnddigital.org
# Where hot-lead / new-customer / failure alerts go
ADMIN_EMAIL=you@example.com

# ---- Outreach autopilot ----
# A real postal address is legally required in commercial email (CAN-SPAM). A PO box works.
PHYSICAL_ADDRESS=CND Digital, PO Box 000, Green Bay, WI 54301
SENDER_NAME=Charlie
# 1 = automatically send new emails + 3-day follow-ups, weekdays 9am-4pm
OUTREACH_AUTOSEND=0
OUTREACH_DAILY_LIMIT=30
OUTREACH_TZ=America/Chicago
CALENDLY_URL=https://calendly.com/lakeshoreventures1/30min

# ---- Misc ----
PORT=3000
# DATA_DIR=/var/data   # point at a persistent disk in production
